#!/bin/sh
# Git pre-push hook — Patrick Laumond (laumond-nuxt)
# Valide la suite complète CI/CD locale avant d'autoriser le push vers GitHub

echo ""
echo "=========================================================="
echo "🛡️  [pre-push] Validation CI/CD locale avant envoi distant"
echo "=========================================================="
echo ""

# 1. Vérification ESLint
echo "▶ 1/3 Vérification du code (ESLint)..."
npm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ [pre-push] Échec du linter ! Push annulé."
  echo "💡 Corrigez les erreurs ou lancez 'npm run lint:fix'."
  echo ""
  exit 1
fi
echo "   ✓ Linter OK"
echo ""

# 2. Exécution des tests unitaires Vitest
echo "▶ 2/3 Exécution des tests unitaires (Vitest)..."
npx vitest run
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ [pre-push] Des tests unitaires ont échoué ! Push annulé."
  echo ""
  exit 1
fi
echo "   ✓ Tests OK"
echo ""

# 3. Vérification du build de production Nuxt
echo "▶ 3/3 Vérification du build de production (Nuxt Build)..."
npm run build
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ [pre-push] Échec du build de production ! Push annulé."
  echo ""
  exit 1
fi
echo "   ✓ Build OK"
echo ""

echo "=========================================================="
echo "🎉 [pre-push] Tous les contrôles CI/CD sont au vert !"
echo "🚀 Envoi du code vers GitHub autorisé."
echo "=========================================================="
echo ""
exit 0
